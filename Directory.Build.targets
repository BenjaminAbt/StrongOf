<Project>
  <!-- Evaluate after each project's properties and TargetFramework are known.
       Reference assemblies before .NET 10 do not carry the AOT metadata. -->
  <PropertyGroup Condition="'$(IsAotCompatible)' == 'true'">
    <VerifyReferenceAotCompatibility Condition="'$(VerifyReferenceAotCompatibility)' == '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</VerifyReferenceAotCompatibility>
  </PropertyGroup>
</Project>
