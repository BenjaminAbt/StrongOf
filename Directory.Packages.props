<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Dependencies">
    <!-- System.Text.Json is supplied by the target framework; no package reference is needed. -->
    <!-- EF Core and ASP.NET Core packages follow the target framework's release line. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Security: CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc) - pin patched Microsoft.OpenApi versions.
         Keep each OpenAPI major compatible with Microsoft.AspNetCore.OpenApi's API and source generators:
         net9.0 uses 1.x (Models namespace), net10.0 uses 2.x, net11.0 uses 3.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="1.6.31" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>
  <ItemGroup Label="DevOps">
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <!-- The 0.16 preview line provides RuntimeMoniker.Net11_0 for the .NET 11 benchmarks. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.console" Version="2.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
