<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn analyzers / source generators must target netstandard2.0 -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>netstandard2.0</TargetFramework>

    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Source generators must not depend on the netstandard2.0 facade resolution magic at runtime -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Disable inherited package authoring for this analyzer-only project -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The base props enable PGO which is .NET only; analyzer must not opt in -->
    <TieredPGO>false</TieredPGO>
    <DynamicPGO>false</DynamicPGO>

    <RootNamespace>StrongOf.SourceGenerators</RootNamespace>
    <AssemblyName>StrongOf.SourceGenerators</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the lowest supported compiler (see StrongOfGeneratorRoslynVersion in Directory.Packages.props),
         independent of the Roslyn version used by analyzers and tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(StrongOfGeneratorRoslynVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- Guard: the generator must never reference a newer Roslyn than StrongOfGeneratorRoslynVersion
       (also catches transitive bumps), otherwise consumers on older SDKs can no longer load it. -->
  <Target Name="_StrongOfVerifyRoslynCompatibility" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_StrongOfRoslynReference Include="@(ReferencePath)"
                                Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Microsoft.CodeAnalysis'))" />
    </ItemGroup>
    <Error Condition="'$(StrongOfGeneratorRoslynVersion)' == ''"
           Text="StrongOfGeneratorRoslynVersion is not set (expected in Directory.Packages.props)." />
    <Error Condition="'@(_StrongOfRoslynReference)' != '' and $([MSBuild]::VersionGreaterThan('%(_StrongOfRoslynReference.NuGetPackageVersion)', '$(StrongOfGeneratorRoslynVersion)'))"
           Text="StrongOf.SourceGenerators references %(_StrongOfRoslynReference.NuGetPackageId) %(_StrongOfRoslynReference.NuGetPackageVersion), which is newer than the supported minimum Roslyn $(StrongOfGeneratorRoslynVersion). This would break consumers on older SDKs." />
  </Target>

  <!-- Polyfill init-only setters / records for netstandard2.0 (compile-only); included via SDK default compile items. -->

</Project>
