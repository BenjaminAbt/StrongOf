<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Native AoT Analyzers">
        <IsAotCompatible>true</IsAotCompatible>
        <VerifyReferenceAotCompatibility Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</VerifyReferenceAotCompatibility>
    </PropertyGroup>

    <PropertyGroup Label="Package">
        <PackageId>StrongOf.Domains</PackageId>
        <IsPackable>true</IsPackable>
        <Description>Ready-to-use strongly typed domain primitives for StrongOf including EmailAddress, Url, Iban, CurrencyCode, CountryCode, ZipCode, IpAddress, SemVer, GeoCoordinate and more.</Description>
        <PackageTags>StrongOf, Domains, ValueObjects, DDD, EmailAddress, Iban, Postal, Networking, NativeAOT</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Suppress MA0095 - Base classes (StrongString, StrongGuid, etc.) already implement Equals(object) correctly -->
    <PropertyGroup Label="Analyzers">
        <NoWarn>$(NoWarn);MA0095</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="readme.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StrongOf.SourceGenerators\StrongOf.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\StrongOf\StrongOf.csproj" />
    </ItemGroup>

</Project>
